#!/usr/bin/env python3
"""dbp — debug 百科（鐵律三）

╔══════════════════════════════════════════════════════════════════╗
║  鐵律三：任何錯誤只要被抓到一次 —— AI 抓、人抓、機器抓都算 ——      ║
║  就立刻標記收錄。標記成本必須低到不會有人偷懶跳過。                 ║
║                                                                  ║
║  單次抓到是事件，累積起來才是知識。                                ║
╚══════════════════════════════════════════════════════════════════╝

為什麼需要它（鐵律二抓不完）：
  0 信心路由保證「這一次被驗到」，但同一種坑會在別的檔案、別的專案、
  別的 AI 身上重犯。沒有累積，每次都是第一次。

設計取捨：
  · **必填只有一個欄位**（what）。其餘全部自動抓或可省略 —— 只要標記
    有一點麻煩，忙的時候就會被跳過，而忙的時候正是最會出錯的時候。
  · JSONL append-only。一行一筆，不需 schema migration，天生可聚合。
    沿用 ~/.gbrain/audit/ 的既有慣例，不另造格式。
  · 壞掉也不准擋住呼叫者 —— 記錄失敗就印到 stderr，exit 0。
    一個會讓你工作中斷的記錄工具，最後會被你關掉。

用法（低成本是重點）：
    dbp "topology 的 at 指向不存在的目錄"
    dbp "yaml 純量裡有 at: 被當成 mapping key" -w topology.yaml:48
    dbp "~ 在雙引號裡不展開" -w verify.sh -k human -t shell,quoting

    dbp ls              最近 20 筆
    dbp find yaml       搜尋
    dbp stats           聚合（大數據整理的入口）
    dbp fix <id> "..."  補上後來怎麼解的
"""

import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

DIR = Path(os.environ.get("DEBUGPEDIA_DIR", Path.home() / ".debugpedia"))
WHO = ("ai", "human", "machine")


def _last_line(path):
    """回傳 path 的最後一行字串，檔案不存在或空回 None。"""
    try:
        txt = Path(path).read_text(encoding="utf-8", errors="replace").strip()
        if not txt:
            return None
        lines = [l.strip() for l in txt.splitlines() if l.strip()]
        return lines[-1] if lines else None
    except (FileNotFoundError, OSError):
        return None


def _week_file(when=None):
    d = when or datetime.now(timezone.utc)
    y, w, _ = d.isocalendar()
    return DIR / f"{y}-W{w:02d}.jsonl"


def _repo():
    """自動抓 repo，抓不到就算了 —— 不為了一個欄位讓記錄失敗。"""
    try:
        p = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=2)
        if p.returncode == 0:
            return Path(p.stdout.strip()).name
    except Exception:
        pass
    return None


def _all():
    rows = []
    if not DIR.is_dir():
        return rows
    for f in sorted(DIR.glob("*.jsonl")):
        if f.name.startswith("_"):
            continue
        for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                continue          # 壞行跳過，不讓一行毀掉整份
    return rows


def add(what, where=None, who="ai", tags=None, evidence=None):
    rec = {
        "id": f"{int(time.time()*1000):x}",
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "who": who if who in WHO else "ai",
        "what": what.strip(),
    }
    for k, v in (("where", where), ("tags", tags), ("evidence", evidence),
                 ("repo", _repo()), ("cwd", os.getcwd())):
        if v:
            rec[k] = v
    try:
        DIR.mkdir(parents=True, exist_ok=True)
        with _week_file().open("a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        print(f"dbp {rec['id']} · {rec['what'][:60]}")
    except Exception as e:
        # 絕不擋住呼叫者。會中斷工作的記錄工具最後會被關掉。
        print(f"dbp: 寫入失敗（已忽略）: {e}", file=sys.stderr)
    return 0


def open_item(what, where=None, blocked=None, tags=None):
    """記一條「還沒收尾」。

    為什麼要有這個：錯誤會叫，未完成不會叫。
    2026-07-27 一輪對話裡累積了 5 條「做了但驗不了 / 還沒做 / 等人點頭」，
    全部只活在一則聊天訊息裡 —— 視窗一關就消失，然後變成幾個月後的大患，
    或永遠不被發現直到出事。

    它們不是 bug，所以陰陽眼的錯誤紀錄一條都抓不到。這是另一個 kind。
    """
    rec = {
        "id": f"{int(time.time()*1000):x}",
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "kind": "open",
        "who": "ai",
        "what": what.strip(),
    }
    for k, v in (("where", where), ("blocked", blocked), ("tags", tags),
                 ("repo", _repo()), ("cwd", os.getcwd())):
        if v:
            rec[k] = v
    try:
        DIR.mkdir(parents=True, exist_ok=True)
        with _week_file().open("a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        print(f"dbp open {rec['id']} · {rec['what'][:60]}")
    except Exception as e:
        print(f"dbp: 寫入失敗（已忽略）: {e}", file=sys.stderr)
    return 0


def done(rid, note=""):
    rec = {
        "id": f"{int(time.time()*1000):x}",
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "kind": "done", "closes": rid, "who": "ai",
        "what": note.strip() or f"closed {rid}",
    }
    try:
        DIR.mkdir(parents=True, exist_ok=True)
        with _week_file().open("a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        print(f"dbp done · {rid}")
    except Exception as e:
        print(f"dbp: 寫入失敗（已忽略）: {e}", file=sys.stderr)
    return 0


def list_open():
    rows = _all()
    closed = {r.get("closes") for r in rows if r.get("kind") == "done"}
    items = [r for r in rows if r.get("kind") == "open" and r["id"] not in closed]
    if not items:
        print("\n✓ 沒有未收尾的項目。\n")
        return 0
    now = datetime.now(timezone.utc)
    print(f"\n=== 未收尾 {len(items)} 條 ===\n")
    by_blocked = {}
    for r in items:
        by_blocked.setdefault(r.get("blocked") or "沒擋住，就是還沒做", []).append(r)
    for blk, rs in sorted(by_blocked.items(), key=lambda x: -len(x[1])):
        print(f"  ▸ {blk}")
        for r in rs:
            try:
                age = (now - datetime.fromisoformat(r["ts"])).days
            except Exception:
                age = 0
            aged = f"  ⚠️{age}天" if age >= 3 else ""
            loc = f"  @{r['where']}" if r.get("where") else ""
            print(f"      {r['id']}  {r['what'][:66]}{loc}{aged}")
        print()
    print("  收尾：dbp done <id> [\"怎麼解的\"]\n")
    return 0


def ls(n=20):
    rows = _all()[-n:]
    for r in rows:
        loc = f"  @{r['where']}" if r.get("where") else ""
        fix = "  ✔" if r.get("fix") else ""
        print(f"{r['id']}  {r['ts'][:16]}  [{r['who']:7}] {r['what'][:64]}{loc}{fix}")
    print(f"\n共 {len(_all())} 筆")
    return 0


def find(q):
    q = q.lower()
    hits = [r for r in _all()
            if q in json.dumps(r, ensure_ascii=False).lower()]
    for r in hits:
        loc = f"  @{r['where']}" if r.get("where") else ""
        print(f"{r['id']}  {r['ts'][:10]}  {r['what'][:70]}{loc}")
        if r.get("fix"):
            print(f"         → {r['fix'][:70]}")
    print(f"\n{len(hits)} 筆命中 / 共 {len(_all())}")
    return 0


# 這些指令跑起來就算「有實際執行過」，不必提到檔名
VERIFY_CMD = re.compile(
    r"\b(pytest|python3?\s+-m\s+\w+|python3?\s+\S+\.py|node|npm\s+(test|run)|bun\s+test|"
    r"cargo\s+(test|build|check)|go\s+test|tsc|eslint|ruff|mypy|shellcheck|make|"
    r"probe\.py|lint\.py|curl|git\s+hook\s+run|bash\s+\S+\.sh|sh\s+\S+\.sh)\b")


def _jsonl(name):
    p = DIR / "ledger" / name
    if not p.exists():
        return []
    out = []
    for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if line:
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return out


def unverified(paths):
    """鐵律二的機械化：這些檔改完之後，到底有沒有任何指令實際碰過？

    以前「產出者不得自驗 / 換一條路驗」只是口號 —— 沒有任何東西能證明
    改完之後真的跑過什麼。2026-07-27 就是這樣把一份 yaml 的語法改壞
    然後直接往下走，靠運氣才發現。

    判定（刻意寬鬆，寧可放過也不亂擋 —— 假紅比沒有更糟）：
      最後一次編輯之後，只要有任何一條指令
        · 提到這個檔名，或
        · 是公認的驗證指令（pytest / lint / build / curl …）
      就算驗過。真的什麼都沒跑，才報。
    """
    edits = _jsonl("_edits.jsonl")
    runs = _jsonl("_runs.jsonl")
    if not edits:
        return []          # 沒有編輯紀錄就不能亂指控（hook 可能沒裝）
    bad = []
    for p in paths:
        ap = os.path.abspath(os.path.expanduser(p))
        base = os.path.basename(ap)
        mine = [e for e in edits if e.get("path") == ap]
        if not mine:
            continue       # 這個檔不是這台機器上編輯的，無從判斷
        last = max(e.get("ts", 0) for e in mine)
        after = [r for r in runs if r.get("ts", 0) > last]
        if any(base in (r.get("cmd") or "") or VERIFY_CMD.search(r.get("cmd") or "")
               for r in after):
            continue
        bad.append((p, len(after)))
    return bad


def risk(target):
    """動手前問一句：這個檔／這類操作，以前在哪裡摔過？

    這是把陰陽眼從「事後查得到」變成「事前擋得住」的那一步。
    差別很實際：`dbp find` 要人先想到去查，而想不到去查的那個時刻，
    正是要犯錯的時刻。risk 是給 hook 在動手當下自動呼叫的。
    """
    rows = [r for r in _all() if r.get("kind") not in ("open", "done")]
    t = str(target)
    base = os.path.basename(t.rstrip("/")) or t
    stem = os.path.splitext(base)[0]
    ext = os.path.splitext(base)[1].lstrip(".")

    direct, kin = [], []
    for r in rows:
        blob = f"{r.get('where','')} {r.get('what','')} {r.get('tags','')}".lower()
        if base.lower() in blob or (len(stem) > 3 and stem.lower() in blob):
            direct.append(r)
        elif ext and ext in (r.get("tags") or "").lower():
            kin.append(r)

    # 同副檔名的族群風險（yaml 的引號、sh 的展開…都是跨檔重複的）
    if ext and not kin:
        for r in rows:
            if ext in f"{r.get('where','')}".lower() and r not in direct:
                kin.append(r)

    if not direct and not kin:
        print(f"  陰陽眼：{base} 無前科")
        return 0
    print(f"\n⚠️  陰陽眼 · {base} 的前科")
    for r in direct[:6]:
        print(f"    · {r['what'][:96]}")
        if r.get("fix"):
            print(f"        → {r['fix'][:88]}")
    if kin:
        print(f"    ── 同類（.{ext}）踩過 {len(kin)} 次 ──")
        for r in kin[:4]:
            print(f"    · {r['what'][:96]}")
    print()
    return 1


def rules(min_hits=2):
    """從錯誤史歸納出法則候選。

    單筆是事件，重複才是法則。一個標籤累積到 min_hits 次，
    它就不是零星 bug 了，是一個該從結構上關掉的類別 ——
    這時候要做的是消滅整類，不是再修一個個案。
    """
    rows = [r for r in _all() if r.get("kind") not in ("open", "done")]
    by_tag = {}
    for r in rows:
        for t in (r.get("tags") or "").split(","):
            t = t.strip()
            if t and t not in ("meta", "auto", "self"):
                by_tag.setdefault(t, []).append(r)

    hot = {k: v for k, v in by_tag.items() if len(v) >= min_hits}
    if not hot:
        print(f"\n還沒有任何類別達到 {min_hits} 次。單筆是事件，重複才是法則。\n")
        return 0

    print(f"\n=== 法則候選 · 出現 ≥{min_hits} 次的類別 ===\n")
    for tag, rs in sorted(hot.items(), key=lambda x: -len(x[1])):
        span = {r.get("repo") or "?" for r in rs}
        cross = "  ⚠️跨 repo" if len(span) > 1 else ""
        print(f"■ {tag}  ×{len(rs)}{cross}")
        for r in rs[:3]:
            print(f"    · {r['what'][:88]}")
        if len(rs) > 3:
            print(f"    · …還有 {len(rs)-3} 筆")
        print()
    print("  ≥2 次 = 該從結構上關掉這一類，不是再修一個個案。")
    print("  關掉的方式：加一道機械檢查，讓這類錯誤不可能再產生。\n")
    return 0


def stats():
    rows = _all()
    if not rows:
        print("還沒有紀錄。第一次抓到錯誤時跑：dbp \"描述\"")
        return 0
    by_who, by_repo, by_tag = {}, {}, {}
    fixed = 0
    for r in rows:
        by_who[r.get("who", "?")] = by_who.get(r.get("who", "?"), 0) + 1
        k = r.get("repo") or "(無 repo)"
        by_repo[k] = by_repo.get(k, 0) + 1
        for t in (r.get("tags") or "").split(","):
            t = t.strip()
            if t:
                by_tag[t] = by_tag.get(t, 0) + 1
        fixed += bool(r.get("fix"))
    print(f"\n總計 {len(rows)} 筆 · 已補解法 {fixed} 筆 ({fixed*100//max(len(rows),1)}%)\n")
    for title, d in (("誰抓到", by_who), ("哪個 repo", by_repo), ("標籤", by_tag)):
        if not d:
            continue
        print(f"  {title}")
        for k, v in sorted(d.items(), key=lambda x: -x[1])[:10]:
            print(f"    {v:4}  {k}")
        print()
    return 0


SWEEP_EXT = (".md", ".yaml", ".yml", ".toml", ".json", ".py", ".sh")
SWEEP_SKIP = {".git", "node_modules", "__pycache__", "dist", "build",
              "target", ".venv", "venv", ".next", "coverage"}
# 路徑判定：第一版只要「有斜線」就算，結果 812 條裡九成五是假陽性 ——
# try/except、Python/Rust、application/json、tools/list、github.com/... 全中。
# 假紅比沒有更糟：它會訓練人忽略紅燈。
#
# 所以改成硬性要求「已知程式碼副檔名結尾」。散文的斜線不帶副檔名，自然被排除。
# 寧可漏抓也不亂報 —— sweep 的價值在「報出來的都該處理」。
CODE_EXT = r"(?:py|md|ya?ml|toml|json|sh|ts|tsx|js|mjs|rs|txt|sql|db|sqlite|plist|jsonl|lock|cfg|ini)"
PATHISH = re.compile(
    r"(?<![:\w])"                      # 前面不是 :// 也不是英數（擋 URL 與 詞尾）
    r"((?:~|\.{1,2})?/[\w.\-~/]*\.%s|[\w.\-]+(?:/[\w.\-]+)+\.%s)" % (CODE_EXT, CODE_EXT))
URLISH = re.compile(r"https?://|www\.|github\.com|\w+\.(?:com|org|net|io|dev)/")
# 這一行是在「拆穿」而不是「宣稱」→ 不算死引用。
DEBUNK = re.compile(
    # 這一行在「拆穿」而不是「宣稱」
    r"實查|為假|不在\s*repo|不存在|前科|曾宣稱|反面教材|假宣稱|"
    r"doesn'?t exist|not in repo|debunk|phantom|例[：:]|例如|"
    # 這一行講的是「別的 repo 的 hash」，本來就不該在本 repo 找得到。
    # 2026-07-27：漏了這類，讓 upstream 的 laap-AGI hash 佔了假陽性七成。
    r"upstream|上游|laap-AGI|遠端|另一個\s*repo|跨\s*repo|!=|≠")
HASHISH = re.compile(r"\b([0-9a-f]{7,40})\b")
DATEISH = re.compile(r"(?:最後更新|最後校準|last[ _-]?updated?|updated)[：:\s]*(\d{4})-(\d{2})-(\d{2})")


def _sweep_files(root):
    out = []
    for dp, dns, fns in os.walk(root):
        dns[:] = [d for d in dns if d not in SWEEP_SKIP and not d.startswith(".")]
        for fn in fns:
            if fn.endswith(SWEEP_EXT):
                out.append(os.path.join(dp, fn))
        if len(out) > 4000:
            break
    return out


def sweep(root=".", record=False):
    """掃出『沒有證據撐的宣稱』，列成刪除候選。

    這支不是再加一道閘 —— 閘是防新的屎，sweep 是鏟既有的。
    每條都附證據，因為「建議刪掉」本身也是一個宣稱，也得配得上它的證據。
    """
    root = os.path.abspath(os.path.expanduser(root))
    files = _sweep_files(root)
    today = datetime.now(timezone.utc).date()
    dead_ref, dead_hash, rotten, findings = [], [], [], []
    # 抑制計數必須被印出來。每個抑制詞都是牆上的一個洞 ——
    # 洞可以有，但不能沒人知道它在那裡。閘一旦擁有「什麼不算問題」的
    # 裁量權又沒人看著，它就從屠龍者變成龍。
    suppressed = {}

    in_git = subprocess.run(["git", "-C", root, "rev-parse", "--git-dir"],
                            capture_output=True, text=True).returncode == 0

    for f in files:
        try:
            txt = open(f, encoding="utf-8", errors="replace").read()
        except Exception:
            continue
        rel = os.path.relpath(f, root)

        for ln, line in enumerate(txt.splitlines(), 1):
            if line.lstrip().startswith(("#!", "//", "http")):
                continue
            if URLISH.search(line):
                suppressed["URL 行"] = suppressed.get("URL 行", 0) + 1
                continue          # URL 裡的斜線不是本機路徑
            for ref in set(PATHISH.findall(line)):
                if "..." in ref:
                    dead_ref.append((rel, ln, ref, "含縮寫，機器驗不了"))
                    continue
                p = os.path.expanduser(ref)
                if not os.path.isabs(p):
                    p = os.path.join(root, ref)
                if not os.path.exists(p):
                    dead_ref.append((rel, ln, ref, "路徑不存在"))

        if in_git:
            for h in set(HASHISH.findall(txt)):
                if h.isdigit() or len(h) < 7:
                    continue
                r = subprocess.run(["git", "-C", root, "cat-file", "-e", f"{h}^{{commit}}"],
                                   capture_output=True)
                if r.returncode != 0 and re.search(rf"(commit|hash|@|至)\s*`?{h}", txt):
                    # 「宣稱它是真的」和「引用它當反面教材」要分開 ——
                    # 2026-07-27 這裡差點把 8 處反面教材報成「謊言繁殖」。
                    # 抓鬼工具生出誇大的鬼，那個誇大會變成下一個要抓的鬼。
                    for ln in txt.splitlines():
                        if h not in ln:
                            continue
                        if DEBUNK.search(ln):
                            suppressed["DEBUNK 詞"] = suppressed.get("DEBUNK 詞", 0) + 1
                            break
                        dead_hash.append((rel, h))
                        break

        m = DATEISH.search(txt)
        if m:
            try:
                d = datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)), tzinfo=timezone.utc).date()
                age = (today - d).days
                if age > 14:
                    rotten.append((rel, m.group(0).strip(), age, len(txt)))
            except ValueError:
                pass

    print(f"\n=== 陰陽眼 sweep · {root} ===")
    print(f"掃了 {len(files)} 個檔\n")

    if dead_ref:
        print(f"■ 死引用 {len(dead_ref)} 條 — 指了個不存在的東西")
        agg = {}
        for rel, ln, ref, why in dead_ref:
            agg.setdefault(rel, []).append((ln, ref, why))
        for rel, items in sorted(agg.items(), key=lambda x: -len(x[1]))[:12]:
            print(f"  {rel}  ({len(items)} 條)")
            for ln, ref, why in items[:3]:
                print(f"      :{ln}  {ref}   ← {why}")
        print()
        findings.append(f"死引用 {len(dead_ref)} 條")

    if dead_hash:
        print(f"■ 死 commit {len(dead_hash)} 條 — 引用了此 repo 沒有的 hash")
        for rel, h in dead_hash[:10]:
            print(f"  {rel}  →  {h}")
        print()
        findings.append(f"死 commit {len(dead_hash)} 條")

    if rotten:
        print(f"■ 腐朽 {len(rotten)} 檔 — 自稱是現況，但已超過 14 天沒更新")
        for rel, stamp, age, size in sorted(rotten, key=lambda x: -x[2])[:12]:
            flag = "  ← 又大又舊，優先砍" if size > 15000 else ""
            print(f"  {age:4}天  {size:>7,}B  {rel}   ({stamp}){flag}")
        print()
        findings.append(f"腐朽 {len(rotten)} 檔")

    if suppressed:
        tot = sum(suppressed.values())
        print(f"■ 已抑制 {tot} 條 — 這是牆上的洞，真陽性也可能躲在裡面")
        for k, v in sorted(suppressed.items(), key=lambda x: -x[1]):
            print(f"    {v:5}  {k}")
        print("    抑制規則在 dbp 的 URLISH / DEBUNK。覺得漏抓就去看那兩條，別信這裡的綠。\n")

    if not findings:
        print("✓ 沒掃到死引用 / 死 commit / 腐朽宣稱。（但看上面抑制了幾條）\n")
        return 0

    print("處置順序（先砍後修 —— 刪掉比補證據便宜）：")
    print("  1. 腐朽又大的檔：問『這份還有人讀嗎』，沒有就刪，不要更新它")
    print("  2. 死引用：宣稱指向不存在的東西 → 刪那句，不是去把檔案生出來")
    print("  3. 死 commit：查不到就是幻覺，整句刪掉\n")

    if record:
        for f in findings:
            add(f"sweep {os.path.basename(root)}: {f}", where=root,
                who="machine", tags="sweep,cleanup")
        print(f"已收進陰陽眼（{len(findings)} 筆）\n")
    return 1


def fix(rid, text):
    """補解法：append 一筆 fix 記錄。不改寫舊行 —— append-only 才安全。"""
    return add(f"[fix of {rid}] {text}", who="ai", tags="fix")


# ── 雜湊鏈 ──────────────────────────────────────────────────────────
# ledger 每筆紀錄含 prev = 前一筆整行 JSON 的 sha256。寫入當下算，不事後補。
# 第一筆為 "genesis"。鏈在寫的當下建立，讀的時候驗證。


def _chain_prev(path):
    """回傳 path 最後一筆的 sha256（hex），空檔回 "genesis"。
    
    如果最後一筆是接地前資料（無 prev 欄位），也回 "genesis"，
    讓新鏈從此地開始。舊資料不參與鏈但也不被刪除。
    """
    last = _last_line(path)
    if last is None:
        return "genesis"
    # 檢查最後一筆是否有 prev 欄位：沒有 → 接地前資料，新鏈從 genesis 開始
    try:
        rec = json.loads(last)
        if not rec.get("prev"):
            return "genesis"
    except (json.JSONDecodeError, TypeError):
        pass
    return hashlib.sha256(last.encode("utf-8")).hexdigest()


def chain_append(data, ledger_name):
    """統一的鏈附加入口：計算 prev → 加入 data → append。
    
    四函式之一（與 _chain_prev、_read_chain、verify_chain 同級）。
    兩支 hook（risk-gate、autocapture）與 shell 指令帳都經此寫入。
    
    ledger_name='edits' → _edits.jsonl, 'runs' → _runs.jsonl。
    若 data 含 'path'（現存檔案），自動補 mtime 與 sha256。
    
    接地處理：若 prev="genesis" 且已有舊資料（無 prev），
    在先寫一筆 chain_start 標記，讓 verify 知道從何起算。
    """
    ledger_file = _ledger_file(ledger_name)
    data["prev"] = _chain_prev(str(ledger_file))
    ap = data.get("path", "")
    if ap and os.path.isfile(ap):
        try:
            st = os.stat(ap)
            data.setdefault("mtime", round(st.st_mtime, 3))
        except Exception:
            pass
        try:
            with open(ap, "rb") as fh:
                data.setdefault("sha", hashlib.sha256(fh.read()).hexdigest()[:12])
        except Exception:
            pass
    try:
        ledger_file.parent.mkdir(parents=True, exist_ok=True)
        # 接地標記：首次在舊資料上建鏈時，先寫 chain_start
        if data.get("prev") == "genesis":
            last = _last_line(str(ledger_file))
            if last is not None:
                try:
                    rec = json.loads(last)
                    if not rec.get("prev") and not rec.get("chain_start"):
                        marker = {"ts": __import__("time").time(),
                                  "chain_start": True,
                                  "note": "接地標記：此前紀錄無雜湊鏈，verify 從此起算"}
                        with ledger_file.open("a", encoding="utf-8") as f:
                            f.write(json.dumps(marker, ensure_ascii=False) + "\n")
                except (json.JSONDecodeError, TypeError):
                    pass
        with ledger_file.open("a", encoding="utf-8") as f:
            f.write(json.dumps(data, ensure_ascii=False) + "\n")
        return True
    except Exception as e:
        print(f"chain_append: 寫入失敗（已忽略）: {e}", file=sys.stderr)
        return False


def _read_chain(path):
    """走完整條鏈，回傳 (ok, 斷行行號, 總行數, 接地前筆數, 鏈筆數, [chain hash列表])。
    ok=True：鏈完整；ok=False：斷在第 n 行。
    既有無 prev 的舊紀錄視為接地前資料，跳過不驗。
    若遇到 {"chain_start":true,...} 標記，從該行起算鏈起點。
    回傳的 hashes 只含鏈紀錄（不含接地前舊資料）。
    """
    try:
        lines = Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
    except FileNotFoundError:
        return True, None, 0, 0, 0, []
    lines = [l.strip() for l in lines if l.strip()]
    n = 0
    pre_chain = 0
    chain_n = 0
    hashes = []
    chain_started = False
    in_chain = False
    for line in lines:
        n += 1
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            return False, n, n, pre_chain, chain_n, hashes
        h = hashlib.sha256(line.encode("utf-8")).hexdigest()
        prev = rec.get("prev", "")
        if rec.get("chain_start"):
            chain_started = True
            in_chain = True
            pre_chain = n - 1  # 此行之前都算接地前
            continue
        if not prev:
            continue
        chain_n += 1
        if not chain_started:
            chain_started = True
            in_chain = True
            pre_chain = n - 1
            if prev != "genesis":
                return False, n, n, pre_chain, chain_n, hashes
        else:
            expected = hashlib.sha256(lines[n-2].encode("utf-8")).hexdigest()
            if prev != expected:
                return False, n, n, pre_chain, chain_n, hashes
        hashes.append(h)
    if not chain_started:
        pre_chain = n  # 整份都沒有鏈資料
    return True, None, n, pre_chain, chain_n, hashes


def _ledger_file(which="edits"):
    name = "_edits.jsonl" if which == "edits" else "_runs.jsonl"
    return Path(DIR) / "ledger" / name


def anchor(human=False, which="edits", all_ledgers=False):
    """印出錨點字串。預設一行給機器；--human 給 Ryan 貼手機。
    which="edits"|"runs"|"all"。
    """
    targets = ["edits", "runs"] if all_ledgers else [which]
    rc = 0
    for w in targets:
        p = _ledger_file(w)
        ok, broken, n, pre_chain, chain_n, hashes = _read_chain(str(p))
        label = {"edits": "edits", "runs": "runs"}.get(w, w)
        if n == 0:
            print(f"錨點({label})：空鏈（尚無紀錄）")
            rc = rc or 1
            continue
        last_hash = hashes[-1] if hashes else "genesis"
        ts = datetime.now(timezone.utc)

        if human:
            human_prev = "genesis"
            human_prev_n = 0
            try:
                for line in Path(str(p)).read_text().splitlines():
                    line = line.strip()
                    if not line:
                        continue
                    rec = json.loads(line)
                    if rec.get("anchored"):
                        h = hashlib.sha256(line.encode("utf-8")).hexdigest()
                        if h in hashes:
                            idx = hashes.index(h)
                            human_prev = h[:12]
                            human_prev_n = idx + 1
            except Exception:
                pass
            count_since = chain_n - human_prev_n
            print(f"🔗 錨點({label}) · {ts.strftime('%Y-%m-%d %H:%M UTC')}")
            print(f"   目前 hash: {last_hash[:12]}  （鏈第 {chain_n} 筆）")
            print(f"   上次人工: {human_prev[:12]}  （鏈第 {human_prev_n} 筆，相隔 {count_since} 筆）")
            print(f"   鏈完整: {'✓' if ok else f'✗ 斷在第 {broken} 行!'}")
        else:
            print(f"{label} {last_hash[:12]} {chain_n} {ts.strftime('%Y-%m-%dT%H:%M:%SZ')}")
        if not ok:
            rc = 1
    return rc


def verify_chain(anchor_hash=None, which="edits"):
    """驗證鏈完整性。--anchor <hash>[:<n>] 檢查 hash 是否在第 n 筆位置。
    which="edits"|"runs"。
    """
    p = _ledger_file(which)
    label = {"edits": "edits", "runs": "runs"}.get(which, which)
    ok, broken, n, pre_chain, chain_n, hashes = _read_chain(str(p))

    if n == 0:
        print(f"verify-chain({label}): 鏈為空")
        return 0 if not anchor_hash else 1

    if not ok:
        print(f"verify-chain({label}): ✗ 斷在第 {broken} 行")
        return 1

    coverage = chain_n / n if n > 0 else 0
    last_hash = hashes[-1] if hashes else "genesis"
    pre_msg = f" · chain_start 前 {pre_chain} 筆不在鏈上" if pre_chain > 0 else ""
    print(f"verify-chain({label}): ✓ 已驗 {chain_n} / 總 {n} 筆（覆蓋率 {coverage:.0%}{pre_msg}）")
    print(f"                       末筆 hash {last_hash[:12]}")

    if coverage < 0.9 and chain_n > 0:
        print(f"             ✗ 鏈覆蓋率不足（{coverage:.0%}），疑似斷層或舊資料未遷移")
        return 1

    if anchor_hash:
        parts = anchor_hash.split(":")
        hkey = parts[0]
        expect_n = int(parts[1]) if len(parts) > 1 and parts[1] else None

        found = [(i + 1, h) for i, h in enumerate(hashes) if h.startswith(hkey)]
        if not found:
            print(f"             ✗ 錨點 {hkey[:12]} 不在鏈上——整本被換過")
            return 1

        if expect_n is not None:
            actual_n = found[0][0]
            if actual_n != expect_n:
                print(f"             ✗ 錨點 {hkey[:12]} 在第鏈第 {actual_n} 筆而非宣告的 {expect_n}——疑似截尾或重排")
                return 1
            if chain_n < expect_n:
                print(f"             ✗ 疑似截尾：宣告 {expect_n} 筆，現存 {chain_n} 筆")
                return 1

        print(f"             ✓ 錨點 {hkey[:12]} 在鏈上（第 {found[0][0]} 筆）")
        return 0

    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[0]
    if cmd == "ls":
        return ls(int(argv[1]) if len(argv) > 1 else 20)
    if cmd == "find":
        return find(" ".join(argv[1:])) if len(argv) > 1 else find("")
    if cmd == "stats":
        return stats()
    if cmd == "risk":
        return risk(argv[1]) if len(argv) > 1 else 0
    if cmd == "rules":
        return rules(int(argv[1]) if len(argv) > 1 else 2)
    if cmd == "open":
        if len(argv) == 1:
            return list_open()
        what, where, blocked, tags = [], None, None, None
        i = 1
        while i < len(argv):
            a = argv[i]
            if a in ("-w", "--where") and i + 1 < len(argv):
                where = argv[i + 1]; i += 2
            elif a in ("-b", "--blocked") and i + 1 < len(argv):
                blocked = argv[i + 1]; i += 2
            elif a in ("-t", "--tags") and i + 1 < len(argv):
                tags = argv[i + 1]; i += 2
            else:
                what.append(a); i += 1
        return open_item(" ".join(what), where, blocked, tags)
    if cmd == "done":
        if len(argv) < 2:
            print("用法: dbp done <id> [\"怎麼解的\"]", file=sys.stderr)
            return 2
        return done(argv[1], " ".join(argv[2:]))
    if cmd == "sweep":
        rest = [a for a in argv[1:] if a != "--record"]
        return sweep(rest[0] if rest else ".", record="--record" in argv)
    if cmd == "fix":
        if len(argv) < 3:
            print("用法: dbp fix <id> \"怎麼解的\"", file=sys.stderr)
            return 2
        return fix(argv[1], " ".join(argv[2:]))
    if cmd == "unverified":
        if len(argv) < 2:
            print("用法: dbp unverified <檔案...>", file=sys.stderr)
            return 2
        bad = unverified(argv[1:])
        if not bad:
            print("\n✓ 全數已驗證\n")
        else:
            print(f"\n⚠️  未驗證 {len(bad)} 檔")
            for p, n in bad:
                print(f"    {p}  — 編輯後只跑了 {n} 條指令，無驗證器")
            print()
        return 1 if bad else 0
    if cmd == "_chain-prev":
        if len(argv) < 2:
            print("用法: dbp _chain-prev <ledger/檔名>", file=sys.stderr)
            return 2
        return print(_chain_prev(str(DIR / argv[1]))) or 0
    if cmd == "_chain-append":
        if len(argv) < 2 or argv[1] not in ("edits", "runs"):
            print("用法: dbp _chain-append <edits|runs>", file=sys.stderr)
            return 2
        try:
            raw = sys.stdin.read()
            data = json.loads(raw) if raw.strip() else {}
        except json.JSONDecodeError:
            print("_chain-append: stdin 須為 JSON", file=sys.stderr)
            return 2
        return 0 if chain_append(data, argv[1]) else 1
    if cmd == "anchor":
        has_all = "--all" in argv
        return anchor(human="--human" in argv or "-H" in argv,
                      which="edits", all_ledgers=has_all)
    if cmd == "verify-chain":
        anchor_hash = None
        which = "edits"
        for i, a in enumerate(argv[1:], 1):
            if a in ("edits", "runs"):
                which = a
            if a == "--anchor" and i < len(argv) - 1:
                anchor_hash = argv[i + 1]
        return verify_chain(anchor_hash, which=which)

    # 預設就是記一筆 —— 最常用的動作不該需要子指令
    what, where, who, tags, ev = [], None, "ai", None, None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-w", "--where") and i + 1 < len(argv):
            where = argv[i + 1]; i += 2
        elif a in ("-k", "--who") and i + 1 < len(argv):
            who = argv[i + 1]; i += 2
        elif a in ("-t", "--tags") and i + 1 < len(argv):
            tags = argv[i + 1]; i += 2
        elif a in ("-e", "--evidence") and i + 1 < len(argv):
            ev = argv[i + 1]; i += 2
        else:
            what.append(a); i += 1
    if not what:
        print("用法: dbp \"描述\" [-w 位置] [-k ai|human|machine] [-t 標籤]", file=sys.stderr)
        return 2
    return add(" ".join(what), where, who, tags, ev)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
